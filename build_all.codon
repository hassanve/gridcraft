import os

V = "0.14.2"
REPO = "hassanve/gridcraft"
U = "https://github.com/" + REPO + "/releases/"
B = "gridcraft_" + V + "-persian_amd64"
A = "com.github.hassanve.gridcraft"

def g2j(gy: int, gm: int, gd: int) -> str:
    g_d_m = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]
    gy2 = gy + 1 if gm > 2 else gy
    days = 355666 + (365 * gy) + ((gy2 + 3) // 4) - ((gy2 + 99) // 100) + ((gy2 + 399) // 400) + gd + g_d_m[gm - 1]
    jy = -1595 + (33 * (days // 12053))
    days %= 12053
    jy += 4 * (days // 1461)
    days %= 1461
    if days > 365:
        jy += (days - 1) // 365
        days = (days - 1) % 365
    if days < 186:
        jm = 1 + (days // 31)
        jd = 1 + (days % 31)
    else:
        jm = 7 + ((days - 186) // 30)
        jd = 1 + ((days - 186) % 30)
    ms = str(jm) if jm >= 10 else "0" + str(jm)
    ds = str(jd) if jd >= 10 else "0" + str(jd)
    return str(jy) + "/" + ms + "/" + ds

def get_jalali_today() -> str:
    os.system("TZ='Asia/Tehran' date '+%Y %m %d' > /tmp/.gc_date")
    with open("/tmp/.gc_date", "r") as f:
        parts = f.read().strip().split(" ")
        if len(parts) == 3:
            return g2j(int(parts[0]), int(parts[1]), int(parts[2]))
    return "1405/08/10"

JDATE = get_jalali_today()

def sh(c: str):
    if os.system(c) != 0:
        raise RuntimeError("Failed: " + c)

def wr(p: str, s: str):
    with open(p, "w") as f:
        f.write(s)

SHELL_SCRIPT = """URL="https://github.com/hassanve/gridcraft/releases/"
DL_DIR="$HOME/Downloads"
mkdir -p "$DL_DIR"

START_MARKER=$(mktemp)
notify-send "GridCraft Updater | """ + JDATE + """" "صفحه Releases باز شد. هر نسخه‌ای را که می‌خواهید دانلود کنید تا پس از اتمام دانلود، به صورت خودکار نصب شود..." 2>/dev/null || true
xdg-open "$URL" >/dev/null 2>&1 &

for i in $(seq 1 900); do
    sleep 2
    FOUND=$(find "$DL_DIR" -maxdepth 1 \\( -name "gridcraft*.AppImage" -o -name "gridcraft*.deb" -o -name "gridcraft*.rpm" -o -name "gridcraft*.tar.zst" -o -name "gridcraft*.flatpak" -o -name "gridcraft*.snap" \\) -newer "$START_MARKER" 2>/dev/null | head -n 1)
    if [ -n "$FOUND" ] && [ ! -f "${FOUND}.part" ] && [ ! -f "${FOUND}.crdownload" ]; then
        S1=$(stat -c%s "$FOUND" 2>/dev/null || echo 0)
        sleep 2
        S2=$(stat -c%s "$FOUND" 2>/dev/null || echo 0)
        if [ "$S1" -gt 100000 ] && [ "$S1" = "$S2" ]; then
            rm -f "$START_MARKER"
            notify-send "GridCraft Updater" "دانلود کامل شد! در حال نصب خودکار فایل انتخابی شما..." 2>/dev/null || true
            case "$FOUND" in
                *.AppImage)
                    chmod +x "$FOUND"
                    if [ -n "$APPIMAGE" ]; then
                        mv "$FOUND" "$APPIMAGE"
                        notify-send "GridCraft Updater" "نسخه جدید AppImage جایگزین و اجرا شد!" 2>/dev/null || true
                        exec "$APPIMAGE"
                    else
                        notify-send "GridCraft Updater" "نسخه AppImage آماده و اجرا شد!" 2>/dev/null || true
                        exec "$FOUND"
                    fi
                    ;;
                *.deb)
                    pkexec dpkg -i "$FOUND"
                    ;;
                *.rpm)
                    pkexec rpm -Uvh --force "$FOUND"
                    ;;
                *.tar.zst)
                    pkexec pacman -U --noconfirm "$FOUND"
                    ;;
                *.flatpak)
                    flatpak install --user -y "$FOUND" || flatpak-spawn --host pkexec flatpak install -y "$FOUND" || pkexec flatpak install -y "$FOUND"
                    ;;
                *.snap)
                    pkexec snap install --dangerous "$FOUND"
                    ;;
            esac
            notify-send "GridCraft Updater" "فرآیند نصب خودکار با موفقیت به پایان رسید!" 2>/dev/null || true
            exit 0
        fi
    fi
done
rm -f "$START_MARKER"
"""

wr("/tmp/gc_updater_test.sh", SHELL_SCRIPT)
sh("sh -n /tmp/gc_updater_test.sh")

UPDATER_CODE = 'pub fn check_latest_version(cur: &str) -> Option<(String, String)> {\n    let script = r#"\n' + SHELL_SCRIPT + '\n"#;\n    let _ = std::process::Command::new("sh").arg("-c").arg(script).spawn();\n    Some((String::from(cur), String::from("https://github.com/hassanve/gridcraft/releases/")))\n}\n'

print("==> [1/4] Injecting Universal Release-Page Auto-Installer (v" + V + " | " + JDATE + ")...")
sh("sed -i 's/Some((ver, url))/Some((_ver, url))/g' crates/ui-egui/src/ribbon.rs")
wr("crates/ui-egui/src/updater.rs", UPDATER_CODE)
sh("sed -i -E 's/^version = \"[0-9]+\\.[0-9]+\\.[0-9]+\"/version = \"" + V + "\"/g' Cargo.toml crates/*/Cargo.toml apps/*/Cargo.toml 2>/dev/null || true")

print("==> [2/4] Compiling release binary with Cargo...")
sh("cargo build --release")

print("==> [3/4] Building .deb, .rpm, and .tar.zst...")
sh("rm -rf /tmp/p " + B + ".*")
sh("mkdir -p /tmp/p/d/DEBIAN /tmp/p/d/usr/bin /tmp/p/d/usr/share/applications /tmp/p/r/BUILD /tmp/p/r/RPMS /tmp/p/r/SOURCES /tmp/p/r/SPECS /tmp/p/r/SRPMS /tmp/p/a/usr/bin /tmp/p/a/usr/share/applications")
sh("cp target/release/gridcraft /tmp/p/d/usr/bin/ && chmod 755 /tmp/p/d/usr/bin/gridcraft && cp /tmp/p/d/usr/bin/gridcraft /tmp/p/a/usr/bin/")

dsk = "[Desktop Entry]\nName=GridCraft (Persian)\nExec=gridcraft\nIcon=gridcraft\nTerminal=false\nType=Application\nCategories=Office;Spreadsheet;\n"
wr("/tmp/p/d/usr/share/applications/gridcraft.desktop", dsk)
wr("/tmp/p/a/usr/share/applications/gridcraft.desktop", dsk)
wr("/tmp/p/d/DEBIAN/control", "Package: gridcraft\nVersion: " + V + "-persian\nArchitecture: amd64\nMaintainer: Hassan\nDescription: GridCraft Persian RTL Spreadsheet (Built on " + JDATE + ")\n")
wr("/tmp/p/r/SPECS/g.spec", "Name: gridcraft\nVersion: " + V + "\nRelease: 1.persian\nSummary: GridCraft Persian (" + JDATE + ")\nLicense: MIT\nAutoReqProv: no\n%description\nGridCraft Persian RTL Spreadsheet - Date: " + JDATE + "\n%install\nmkdir -p %{buildroot}/usr/bin %{buildroot}/usr/share/applications\ninstall -m 755 " + os.getcwd() + "/target/release/gridcraft %{buildroot}/usr/bin/gridcraft\ncp /tmp/p/d/usr/share/applications/gridcraft.desktop %{buildroot}/usr/share/applications/\n%files\n/usr/bin/gridcraft\n/usr/share/applications/gridcraft.desktop\n")
wr("/tmp/p/a/.PKGINFO", "pkgname = gridcraft-persian\npkgbase = gridcraft-persian\npkgver = " + V + "-1\npkgdesc = GridCraft Persian RTL Spreadsheet (" + JDATE + ")\nurl = " + U + "\npackager = Hassan\narch = x86_64\nlicense = MIT\n")

sh("dpkg-deb --build /tmp/p/d " + B + ".deb")
sh("rpmbuild --define '_topdir /tmp/p/r' -bb /tmp/p/r/SPECS/g.spec && cp /tmp/p/r/RPMS/x86_64/*.rpm " + B + ".rpm")
sh("tar --zstd --owner=0 --group=0 -C /tmp/p/a -cf " + B + ".tar.zst .PKGINFO usr")

print("==> [4/4] Building .flatpak, .snap, and .AppImage...")
sh("mkdir -p /tmp/p/fp/files/bin /tmp/p/fp/files/share/applications /tmp/p/fp/var && cp /tmp/p/d/usr/bin/gridcraft /tmp/p/fp/files/bin/")
wr("/tmp/p/fp/metadata", "[Application]\nname=" + A + "\nruntime=org.freedesktop.Platform/x86_64/23.08\nsdk=org.freedesktop.Sdk/x86_64/23.08\n")
wr("/tmp/p/fp/files/share/applications/" + A + ".desktop", dsk)
sh("flatpak build-finish /tmp/p/fp --command=gridcraft --share=ipc --share=network --socket=x11 --socket=wayland --device=dri --filesystem=home && flatpak build-export /tmp/p/fpr /tmp/p/fp && flatpak build-bundle /tmp/p/fpr " + B + ".flatpak " + A)

sh("mkdir -p /tmp/p/sn/bin /tmp/p/sn/meta/gui && cp /tmp/p/d/usr/bin/gridcraft /tmp/p/sn/bin/")
wr("/tmp/p/sn/meta/snap.yaml", "name: gridcraft-persian\nversion: '" + V + "'\nsummary: GridCraft Persian (" + JDATE + ")\ndescription: GridCraft Persian RTL Spreadsheet\narchitectures: [amd64]\nbase: core22\ngrade: stable\nconfinement: strict\napps:\n  gridcraft:\n    command: bin/gridcraft\n    plugs: [home, network, x11, wayland, desktop, opengl]\n")
wr("/tmp/p/sn/meta/gui/gridcraft.desktop", dsk)
sh("mksquashfs /tmp/p/sn " + B + ".snap -noappend -comp xz -no-xattrs -no-fragments -all-root >/dev/null")

sh("mkdir -p /tmp/p/ai/usr/bin && cp /tmp/p/d/usr/bin/gridcraft /tmp/p/ai/usr/bin/")
wr("/tmp/p/ai/AppRun", "#!/bin/sh\nexec \"$(dirname \"$(readlink -f \"$0\")\")/usr/bin/gridcraft\" \"$@\"\n")
sh("chmod 755 /tmp/p/ai/AppRun")
wr("/tmp/p/ai/gridcraft.desktop", dsk)
wr("/tmp/p/ai/gridcraft.svg", "<svg xmlns='http://www.w3.org/2000/svg' width='64' height='64'><rect width='64' height='64' fill='#107c41'/></svg>\n")
wr("/tmp/p/rt.c", '#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\nint main(int c,char**v){char s[4096],m[8192];ssize_t n=readlink("/proc/self/exe",s,4095);if(n<0)return 1;s[n]=0;if(c>1&&!strcmp(v[1],"--appimage-offset")){puts("65536");return 0;}snprintf(m,8192,"test -x /tmp/.gc_app/AppRun||unsquashfs -q -f -d /tmp/.gc_app -o 65536 \'%s\'",s);if(system(m)!=0)return 1;v[0]=(char*)"/tmp/.gc_app/AppRun";execv(v[0],v);return 1;}\n')
sh("gcc -O2 -s /tmp/p/rt.c -o /tmp/p/rt && truncate -s 65536 /tmp/p/rt && printf 'AI\\x02' | dd of=/tmp/p/rt bs=1 seek=8 count=3 conv=notrunc 2>/dev/null")
sh("mksquashfs /tmp/p/ai /tmp/p/ai.sqfs -root-owned -noappend -comp xz >/dev/null && cat /tmp/p/rt /tmp/p/ai.sqfs > " + B + ".AppImage && chmod +x " + B + ".AppImage")
print("==> ALL 6 PACKAGES BUILT & READY FOR MANUAL SELECTION + AUTO INSTALL!")
